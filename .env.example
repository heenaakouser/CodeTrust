# Free LLM for dynamic test generation (pick one)

# Option A — Groq (recommended free tier)
# Get a key: https://console.groq.com/keys
CODETRUST_LLM_PROVIDER=groq
CODETRUST_LLM_API_KEY=gsk_your_key_here
CODETRUST_LLM_MODEL=openai/gpt-oss-20b

# Option B — Google Gemini free tier
# CODETRUST_LLM_PROVIDER=gemini
# CODETRUST_LLM_API_KEY=your_gemini_key
# CODETRUST_LLM_MODEL=gemini-2.0-flash

# Aliases also work:
# GROQ_API_KEY=...
# GEMINI_API_KEY=...
